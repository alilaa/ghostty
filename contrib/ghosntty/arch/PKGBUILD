# Package the install prefix compiled in the pinned Arch CI environment.
pkgname=ghosntty
pkgver=${GHOSNTTY_PKGVER:?Use package-arch.sh}
pkgrel=${GHOSNTTY_PKGREL:?Use package-arch.sh}
pkgdesc='Terminal with compact project-colored tabs and Neovim navigation'
arch=('x86_64')
url='https://github.com/alilaa/ghostty'
license=('MIT')
depends=(
    'glibc>=2.44' 'gcc-libs' 'freetype2' 'harfbuzz' 'fontconfig'
    'libpng' 'zlib' 'oniguruma' 'libglvnd' 'glib2' 'wayland' 'libx11'
    "gtk4>=1:$(pkg-config --modversion gtk4)"
    "libadwaita>=1:$(pkg-config --modversion libadwaita-1)"
    'gtk4-layer-shell' 'python' 'python-gobject' 'librsvg'
)
optdepends=(
    'ttf-jetbrains-mono-nerd: terminal font matching the bundled profile'
    'noto-fonts-emoji: emoji font fallback'
)
options=('!strip' '!debug')

package() {
    bash "$GHOSNTTY_SOURCE_DIR/stage-package.sh" "$GHOSNTTY_PREFIX" "$pkgdir"
}
